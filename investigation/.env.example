# =====================================================================
#  FastPay Investigation settings  (investigation/.env)
#  Copy this file to .env. Restart `npm start` after changing anything.
#  Never share this file.
# =====================================================================

# Port for the payment-help page and API. Open http://localhost:4100 after signing in to FastPay.
PORT=4100

# ---------------------------------------------------------------------
# Meta model (understands the customer's complaint)
# Copy these from your Meta developer dashboard. The API must be OpenAI-compatible
# (it must accept POST <base url>/chat/completions).
# If these are empty, the built-in English rules are used instead.
# ---------------------------------------------------------------------
META_API_KEY=
META_BASE_URL=
META_MODEL=

# ---------------------------------------------------------------------
# Investigation
# ---------------------------------------------------------------------
# Timezone used to read "today", "yesterday", "on Monday" and to show times.
INVESTIGATION_TIMEZONE=Africa/Lagos

# A FastPay balance transfer that was debited but not credited is PAYMENT_PENDING for this many
# minutes. After that, it is DEBITED_NOT_CREDITED. (When PayPal has COMPLETED a payment but no credit
# is recorded, it is PAYMENT_CAPTURED_WALLET_NOT_CREDITED straight away: no waiting window.)
INVESTIGATION_PROCESSING_WINDOW_MINUTES=10

# Exceptions (cases staff must act on): who owns them, minutes until one is overdue, and how long a
# payment may stay pending before it becomes an exception itself.
INVESTIGATION_EXCEPTION_OWNER=Payments operations
INVESTIGATION_ESCALATION_MINUTES=60
INVESTIGATION_PENDING_ESCALATION_MINUTES=60

# ---------------------------------------------------------------------
# Connection to FastPay: ONLY through FastPay's read-only investigation window.
# This module has no database access, no FastPay secrets and no PayPal keys.
# FASTPAY_INVESTIGATION_TOKEN must equal INVESTIGATION_API_TOKEN in server/.env.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# ---------------------------------------------------------------------
FASTPAY_INVESTIGATION_TOKEN=
# FASTPAY_API_URL=http://localhost:4000
# FASTPAY_APP_URL=http://localhost:5173

# ---------------------------------------------------------------------
# Internal report API (staff / Module 3). Off when empty.
# With a token set: GET /internal/cases and /internal/cases/<CASE-ID>/report,
# sending the header "Authorization: Bearer <token>". Use a long random value.
# Without it, read reports from the command line: npm run report -- <CASE-ID>
# ---------------------------------------------------------------------
INTERNAL_API_TOKEN=

# ---------------------------------------------------------------------
# Module 3: Decision and resolution (code in ../resolution). REAL money actions.
# It moves money only through FastPay's resolution window, with its own key:
# FASTPAY_RESOLUTION_TOKEN must equal RESOLUTION_API_TOKEN in server/.env (use a new random value).
# The agent uses the Meta keys above.
# ---------------------------------------------------------------------
FASTPAY_RESOLUTION_TOKEN=
# RESOLUTION_MODEL=muse-spark-1.3
# Minutes a confirmation card can be approved. Minutes before a report is too old to act on.
RESOLUTION_APPROVAL_MINUTES=30
RESOLUTION_REPORT_MAX_AGE_MINUTES=30
# A stuck balance transfer is returned to the sender by policy after this many hours.
RESOLUTION_AUTO_RETURN_HOURS=24
# Optional: above this amount (dollars) staff must also approve. Empty = the policy decides alone.
RESOLUTION_STAFF_LIMIT=

# ---------------------------------------------------------------------
# Module 4: FastPay Voice (code in ../digital-human). The microphone on this page appears when it is running.
# Set VOICE_URL= (empty) to turn voice off.
# ---------------------------------------------------------------------
# VOICE_URL=http://localhost:4200
