# =====================================================================
#  FastPay Voice settings  (digital-human/.env)
#  Copy this file to .env. Restart `npm start` after changing anything. Never share this file.
# =====================================================================

# This runs behind the payment-help page (http://localhost:4100), which shows a microphone when this is running.
PORT=4200

# The investigation module (Module 2, which also runs Module 3). This module talks ONLY to it,
# using the same customer endpoints its own chat page uses. No FastPay, PayPal or database access.
INVESTIGATION_URL=http://localhost:4100

# Meta (same keys as investigation/.env). OpenAI-compatible: POST <base url>/chat/completions
META_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
# Reads what the customer said (language, English meaning, intent). Accuracy matters most here.
DH_UNDERSTAND_MODEL=muse-spark-1.1
# Says the replies in the customer's language. Speed matters most here; every amount and reference is checked.
DH_REPLY_MODEL=muse-ember-1.0

# Languages she replies in (default: all five with a YarnGPT key, en,pcm without). Example: DH_LANGUAGES=en,pcm
# DH_LANGUAGES=

# ---------------------------------------------------------------------
# Her speaking voice: YarnGPT (https://yarngpt.ai). Nigerian voices for English, Pidgin, Hausa, Yoruba, Igbo.
# With a key, all five languages are on by default. Without one, the browser's voice is used (English + Pidgin).
# ---------------------------------------------------------------------
YARNGPT_API_KEY=
# Her voice. Every YarnGPT voice speaks all five languages, so one voice is used for all of them.
# Female voices: idera (default, melodic, gentle), zainab, adaora, chinenye, regina, remi, wura, mary.
# DH_VOICE=idera
# Or per language: DH_VOICE_EN, DH_VOICE_PCM, DH_VOICE_HA, DH_VOICE_YO, DH_VOICE_IG


# Conversation memory (language, current case). No payment data is stored here.
DH_DB_PATH=data/digital-human.db
