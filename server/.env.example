# =====================================================================
#  FastPay settings  (server/.env)
#  After changing anything here: stop `npm run dev` (Ctrl+C) and start it again.
#  Never share this file or paste its contents anywhere.
# =====================================================================

# ---------------------------------------------------------------------
# 1. PAYPAL KEYS  (required for PayPal)
#    developer.paypal.com -> Apps & Credentials -> Sandbox -> your app
#    Paste the values right after the "=" with no spaces or quotes.
# ---------------------------------------------------------------------
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# "sandbox" for testing with fake money. Only change to "live" when going to production.
PAYPAL_ENV=sandbox

# ---------------------------------------------------------------------
# 2. PAYPAL WEBHOOK  (optional: instant updates + disputes)
#    developer.paypal.com -> your app -> Webhooks -> copy the "Webhook ID"
# ---------------------------------------------------------------------
PAYPAL_WEBHOOK_ID=

# ---------------------------------------------------------------------
# 3. APP SETTINGS  (already filled in; you don't need to touch these)
# ---------------------------------------------------------------------
PORT=4000

# Secret used to sign login sessions. Generated for you. Changing it logs everyone out.
JWT_SECRET=change-me-to-a-long-random-string

# Show the "Test mode" outcome picker. Set to false before real users get access.
ENABLE_SIMULATION=true

# Seconds a test "pending" payment waits before it settles.
PENDING_SECONDS=20

# ---------------------------------------------------------------------
# 4. INVESTIGATION MODULE (optional)
#    Key for the read-only /api/investigation window used by investigation/.
#    Put the same value in investigation/.env as FASTPAY_INVESTIGATION_TOKEN.
#    Leave empty to keep the window closed.
# ---------------------------------------------------------------------
INVESTIGATION_API_TOKEN=

# Address of the investigation page, used by "Help" and "Report a problem" in the app.
INVESTIGATION_APP_URL=http://localhost:4100

# Module 3 (resolution): the key for FastPay's resolution window (/api/resolution). Off when empty.
# Must equal FASTPAY_RESOLUTION_TOKEN in investigation/.env. Use a different value from INVESTIGATION_API_TOKEN.
RESOLUTION_API_TOKEN=
# Most a customer can get back through automatic resolutions per day (dollars).
RESOLUTION_DAILY_LIMIT=1000
